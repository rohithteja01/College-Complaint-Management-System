# Server Port
PORT=<YOUR_PORT>

# Node Environment ('development' or 'production')
NODE_ENV=<YOUR_ENVIRONMENT>

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGODB_URI=<YOUR_MONGODB_CONNECTION_STRING>

# Frontend Client URLs (Comma-separated for Student and Admin deployed hosts)
ALLOWED_ORIGINS=<YOUR_DEPLOYED_STUDENT_URL>,<YOUR_DEPLOYED_ADMIN_URL>
CLIENT_URL=<YOUR_DEPLOYED_STUDENT_URL>

# JWT Authentication Secret Key
JWT_SECRET=<YOUR_JWT_SECRET>

# JWT Expiration Duration
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------
# Google Gemini AI Configuration
# -------------------------------------------------------------
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-1.5-flash

# -------------------------------------------------------------
# Email Notification Configuration (SMTP)
# -------------------------------------------------------------
# SMTP Host (e.g. smtp.gmail.com, smtp.mailtrap.io, smtp.sendgrid.net)
EMAIL_HOST=<YOUR_SMTP_HOST>

# SMTP Port (587 for TLS, 465 for SSL, 2525 for Mailtrap)
EMAIL_PORT=<YOUR_SMTP_PORT>

# SMTP Authentication Username / Email
EMAIL_USER=<YOUR_SMTP_USERNAME>

# SMTP Authentication Password / App Password
EMAIL_PASSWORD=<YOUR_SMTP_PASSWORD>

# Sender Address shown to students
EMAIL_FROM=<YOUR_SENDER_EMAIL>
